<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tabscreen.viewer"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Needed for any network connection, including the USB tunnel to the Mac (which arrives as localhost). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="TabScreen"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@style/TabScreenTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
